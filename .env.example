# Generate a random secret of at least 32 characters. Do not commit it.
SECRET_KEY=
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=60
INVITATION_EXPIRE_HOURS=72
VERIFICATION_CODE_EXPIRE_MINUTES=10
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_MAX_ATTEMPTS=5
PASSWORD_RESET_CODE_EXPIRE_MINUTES=10
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_LOGIN_IP_LIMIT=60
AUTH_RECOVERY_ACCOUNT_LIMIT=5
AUTH_RECOVERY_IP_LIMIT=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_APP_URL=http://localhost:5173
DATABASE_MODE=mongodb
# Generate separately: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=
# Generate a second distinct Fernet key for stored prompt/response text.
CONTENT_ENCRYPTION_KEY=
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/%2F
RED_TEAM_QUEUE_NAME=sentinel.red_team.local
RED_TEAM_MAX_ATTEMPTS=3
RED_TEAM_EXECUTION_LEASE_SECONDS=120
INTEGRATION_REQUESTS_PER_MINUTE=6
VALIDATOR_MODEL_CACHE_DIR=.model-cache
INJECTION_MODEL_ID=protectai/deberta-v3-base-prompt-injection-v2
INJECTION_MODEL_REVISION=90c9989b1a342275dd0d1a95aad283c04e075671
TOXICITY_MODEL_ID=unitary/toxic-bert
TOXICITY_MODEL_REVISION=4d6c22e74ba2fdd26bc4f7238f50766b045a0d94
VALIDATION_STAGE_TIMEOUT_MS=5000
# Keep false: no calls or probes until the API developers confirm readiness/contracts.
REMOTE_DETECTION_ENABLED=false
DLP_DETECTION_API_KEY=
REMOTE_DETECTION_TIMEOUT_SECONDS=5
PII_PHONE_REGION=US
PROVIDER_TIMEOUT_SECONDS=45
INTERRUPTED_RUN_GRACE_SECONDS=300
ALLOWED_OLLAMA_ORIGINS=http://127.0.0.1:11434
TEST_MONGODB_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0
TEST_MONGODB_DB_NAME=test_sentinel_phase1

# Use a local replica set or an existing transaction-capable MongoDB URL.
MONGODB_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=centurion

# Gmail SMTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
SMTP_FROM_NAME=Sentinel AI
SMTP_USE_TLS=true
SMTP_USE_SSL=false
