# Reference only: enter these in Heroku Settings > Config Vars.
# Do not commit populated copies or load this file into GitHub.
ENVIRONMENT=production
DATABASE_MODE=mongodb
MONGODB_URL=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=sentinel_production
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
SECRET_KEY=
# Preserve the original values when reusing an existing database.
INTEGRATION_ENCRYPTION_KEY=
CONTENT_ENCRYPTION_KEY=
FRONTEND_APP_URL=https://YOUR-SITE.netlify.app
CORS_ORIGINS=https://YOUR-SITE.netlify.app
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Sentinel AI
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Synchronous web requests must fit within Heroku's router deadline.
PROVIDER_TIMEOUT_SECONDS=15
VALIDATION_STAGE_TIMEOUT_MS=4000
REMOTE_DETECTION_TIMEOUT_SECONDS=4
# Set true for managed DLP/Guardrail catalogs after configuring detector access.
REMOTE_DETECTION_ENABLED=false
DLP_DETECTION_API_KEY=
# Required only when enabling the worker and dispatcher for Red Team.
RABBITMQ_URL=
RED_TEAM_QUEUE_NAME=sentinel.red_team.production
# Use the bundled pricing map; update the pinned LiteLLM dependency to refresh it.
LITELLM_LOCAL_MODEL_COST_MAP=True
OTEL_SDK_DISABLED=true
GUARDRAILS_DISABLE_TRACING=true
