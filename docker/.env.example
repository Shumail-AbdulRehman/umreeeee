# python3 docker/setup.py writes a private root .env with unique generated keys.
# Do not copy production credentials into this local stack.
APP_PORT=8080
API_PORT=8001
MAILPIT_PORT=8025
RABBITMQ_UI_PORT=15672
MONGODB_DB_NAME=averiq
SECRET_KEY=
INTEGRATION_ENCRYPTION_KEY=
CONTENT_ENCRYPTION_KEY=
RABBITMQ_PASSWORD=

# CPU classifier packages are included by default. Weights download separately.
INSTALL_LOCAL_ML=true

# Configure only when you want real hosted Red Team generation.
PROMPTFOO_API_KEY=
PROMPTFOO_CLOUD_HOST=https://www.promptfoo.app
RED_TEAM_MAX_ATTEMPTS=3
RED_TEAM_EXECUTION_LEASE_SECONDS=120
INTEGRATION_REQUESTS_PER_MINUTE=6
PROVIDER_TIMEOUT_SECONDS=45
REMOTE_DETECTION_ENABLED=false
DLP_DETECTION_API_KEY=
REMOTE_DETECTION_TIMEOUT_SECONDS=5
PII_PHONE_REGION=US
VALIDATION_STAGE_TIMEOUT_MS=5000
INJECTION_MODEL_ID=protectai/deberta-v3-base-prompt-injection-v2
INJECTION_MODEL_REVISION=90c9989b1a342275dd0d1a95aad283c04e075671
TOXICITY_MODEL_ID=unitary/toxic-bert
TOXICITY_MODEL_REVISION=4d6c22e74ba2fdd26bc4f7238f50766b045a0d94
ALLOWED_OLLAMA_ORIGINS=http://host.docker.internal:11434
